---
pagination:
  data: collections.categories
  size: 1
  alias: category
permalink: "/tagged/{{ category | slugify }}/index.html"
eleventyComputed:
  title: "Category: {{ category }}" 
layout: main
---
<h2>{{ title }}</h2>
<dl class="novel-list">
  {% assign novels = collections.novel | filterByCategory: category %}
  {% for fic in novels reversed %}
  <dt>
    <strong><a href="{{ fic.url }}">{{ fic.data.title }}</a></strong>
    {% if fic.data.r18 %}🔞{% endif %}
    {% if fic.data.last-updated %}<em> - Last Updated: {{ fic.data.last-updated | textDate }}</em>{% endif %}
  </dt>
  <dd>{{ fic.data.blurb }}</dd>
  {% endfor %}
</dl>
---
layout: base
id: wiki
---

<div class="two-col">
  <aside>
    <strong class="mini-title"><a href="/">[ {{ mainHeaderTitle }} ]</a></strong>
    <div class="desktop">
      <nav class="slash-list">
        <ul>
          <li><a href="/">Home</a></li>
          <li><a href="/wiki/">Wiki</a></li>
        </ul>
      </nav>
      <h2>Series:</h2>
      <nav class="tag-list">
        <ul>
          {% for wikiTag in collections.wikiTags %}
            <li>
              <a href="/wiki/tagged/{{ wikiTag.url }}">{{ wikiTag.title }}</a>
            </li>
          {% endfor %}
        </ul>
      </nav>
    </div>
    <div class="mobile">
      <nav class="slash-list">
        <ul>
          <li><a href="/wiki/">Wiki Home</a></li>
          <li><a href="/wiki/tags.html">Wiki Tags</a></li>
        </ul>
      </nav>
    </div>
  </aside>
  <main>
    <h1>{{ title }}</h1>
    {{ content }}
  </main>
</div>
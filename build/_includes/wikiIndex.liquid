---
layout: base
id: wiki
---

<div class="two-col">
  <aside>
    <strong>[ {{ mainHeaderTitle }} ]</strong>
    <nav class="slash-list">
      <ul>
        <li><a href="/">Home</a></li>
        <li><a href="/wiki/">Wiki</a></li>
      </ul>
    </nav>

    <h2>Series:</h2>
    <nav class="tag-list">
      <ul>
        {% for wikiTag in collections.wikiTags %}
          <li>
            <a href="/wiki/tagged/{{ wikiTag.url }}">{{ wikiTag.title }}</a>
          </li>
        {% endfor %}
      </ul>
    </nav>
  </aside>
  <main>
    <h1>{{ title }}</h1>
    {{ content }}
  </main>
</div>
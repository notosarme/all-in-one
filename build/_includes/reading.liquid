---
  chapter_total: 0
  layout: base
  id: reading
---
{% assign url_segments = page.url | split: '/' %}
{% assign story_title = url_segments[3] %}
{% assign chapters = collections.chaptersByStory[story_title] %}
{% assign chapter_total = chapters.size %}
{% if chapter > 1 %}
  {% assign prev = chapter | minus: 1 %}
{% endif %}
{% if chapter < chapter_total %}
  {% assign next = chapter | plus: 1 %}
{% endif %}

<div class="container">
  <header>
    {% render '_pagination', prev: prev, next: next %}
  </header>
  {% if number or title %}
    <h1>{{ title }}</h1>
    <hr />
  {% endif %}
  <main>{{ content }}</main>
  <footer>
    {% render '_pagination', prev: prev, next: next %}
  </footer>
</div>
